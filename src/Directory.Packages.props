<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageVersion Include="Antlr4BuildTasks" Version="12.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="[8.0.0,)" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Ulid" Version="1.3.4" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.1.0" />
    <PackageVersion Include="Npgsql" Version="[9.0.3,)" />
    <PackageVersion Include="MySqlConnector" Version="[2.6.2,)" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="[6.0.1,)" />
    <!-- Patched releases of each line: 8.0.2 keeps net8 consumers on the 8.x package line. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="[8.0.2,)" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="[9.0.21,)" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="[8.0.0,)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0,)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="[8.0.0,)" />
  </ItemGroup>
</Project>
