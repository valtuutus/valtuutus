<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(NetLibVersion)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Valtuutus MySQL and MariaDB schema migrations with Weasel; $(Description)</Description>
        <PackageTags>$(PackageTags);mysql;mariadb;weasel;migrations</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Valtuutus.Data.MySql.Weasel.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Weasel.MySql" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="[10.0.0,)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Valtuutus.Data.MySql\Valtuutus.Data.MySql.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Valtuutus.Data.Weasel.Shared\*.cs" LinkBase="Shared" />
    </ItemGroup>

</Project>
